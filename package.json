<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Neon Multiplayer Arena</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; user-select: none; }
        body {
            background: #05050a;
            overflow: hidden;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            touch-action: none;
        }
        canvas {
            display: block;
            background: radial-gradient(circle at center, #0d0d1a 0%, #050508 100%);
        }

        /* HUD Neon */
        #hud {
            position: absolute; top: 15px; left: 15px;
            color: #00f3ff;
            background: rgba(5, 10, 20, 0.75);
            border: 1px solid #00f3ff;
            box-shadow: 0 0 12px rgba(0, 243, 255, 0.4), inset 0 0 8px rgba(0, 243, 255, 0.2);
            padding: 10px 16px; border-radius: 8px;
            font-size: 13px; letter-spacing: 1px;
            pointer-events: none;
            text-shadow: 0 0 5px #00f3ff;
        }
        #status-dot {
            display: inline-block; width: 8px; height: 8px;
            border-radius: 50%; background: #ff0055;
            box-shadow: 0 0 8px #ff0055; margin-right: 6px;
        }
        #status-dot.online {
            background: #00ff88; box-shadow: 0 0 8px #00ff88;
        }

        /* Virtual Joystick Neon */
        #joystick-zone {
            position: absolute; bottom: 35px; left: 35px;
            width: 130px; height: 130px;
            background: rgba(0, 243, 255, 0.05);
            border: 2px solid rgba(0, 243, 255, 0.5);
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.3), inset 0 0 15px rgba(0, 243, 255, 0.2);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            cursor: grab;
        }
        #joystick-knob {
            width: 52px; height: 52px;
            background: radial-gradient(circle, #ffffff 10%, #00f3ff 70%);
            border-radius: 50%;
            position: absolute;
            box-shadow: 0 0 18px #00f3ff, 0 0 30px #00f3ff;
            pointer-events: none;
        }
    </style>
</head>
<body>

    <div id="hud">
        <span id="status-dot"></span>
        <span id="status-text">OFFLINE (LOKAL)</span> | 
        ONLINE: <span id="player-count">1</span>
    </div>

    <canvas id="gameCanvas"></canvas>

    <!-- Virtual Joystick -->
    <div id="joystick-zone">
        <div id="joystick-knob"></div>
    </div>

    <!-- Load Socket.io jika dijalankan lewat server -->
    <script src="/socket.io/socket.io.js" onerror="console.log('Mode lokal aktif')"></script>
    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const playerCountEl = document.getElementById('player-count');
        const statusDot = document.getElementById('status-dot');
        const statusText = document.getElementById('status-text');

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resize);
        resize();

        const neonColors = ['#00f3ff', '#ff00ff', '#00ff88', '#ffea00', '#ff3366', '#9d00ff'];
        let myId = 'local_player';
        let players = {
            [myId]: {
                x: canvas.width / 2,
                y: canvas.height / 2,
                color: neonColors[Math.floor(Math.random() * neonColors.length)],
                name: 'Kamu',
                trail: []
            }
        };

        const speed = 5;
        let socket = null;

        // --- KONEKSI MULTIPLAYER REAL-TIME ---
        if (typeof io !== 'undefined') {
            socket = io();

            socket.on('connect', () => {
                const oldMe = players[myId];
                delete players[myId];
                myId = socket.id;
                players[myId] = oldMe;

                statusDot.classList.add('online');
                statusText.innerText = 'SERVER PUBLIC';
                socket.emit('move', { x: oldMe.x, y: oldMe.y });
            });

            socket.on('currentPlayers', (serverPlayers) => {
                for (let id in serverPlayers) {
                    if (id !== myId) {
                        players[id] = { ...serverPlayers[id], trail: [] };
                    }
                }
                updateCount();
            });

            socket.on('newPlayer', (data) => {
                players[data.id] = { ...data.player, trail: [] };
                updateCount();
            });

            socket.on('playerMoved', (data) => {
                if (players[data.id]) {
                    players[data.id].x = data.x;
                    players[data.id].y = data.y;
                }
            });

            socket.on('playerDisconnected', (id) => {
                delete players[id];
                updateCount();
            });
        }

        function updateCount() {
            playerCountEl.innerText = Object.keys(players).length;
        }

        // --- KONTROL VIRTUAL JOYSTICK ---
        const zone = document.getElementById('joystick-zone');
        const knob = document.getElementById('joystick-knob');
        let joyActive = false;
        let joyVector = { x: 0, y: 0 };
        const maxRadius = 42;

        function handleJoystickMove(clientX, clientY) {
            const rect = zone.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;

            let dx = clientX - centerX;
            let dy = clientY - centerY;
            const distance = Math.hypot(dx, dy);

            if (distance > maxRadius) {
                dx = (dx / distance) * maxRadius;
                dy = (dy / distance) * maxRadius;
            }

            knob.style.transform = `translate(${dx}px, ${dy}px)`;
            joyVector.x = dx / maxRadius;
            joyVector.y = dy / maxRadius;
        }

        function resetJoystick() {
            joyActive = false;
            joyVector = { x: 0, y: 0 };
            knob.style.transform = `translate(0px, 0px)`;
        }

        zone.addEventListener('touchstart', (e) => {
            e.preventDefault();
            joyActive = true;
            handleJoystickMove(e.touches[0].clientX, e.touches[0].clientY);
        }, { passive: false });

        window.addEventListener('touchmove', (e) => {
            if (!joyActive) return;
            handleJoystickMove(e.touches[0].clientX, e.touches[0].clientY);
        }, { passive: false });

        window.addEventListener('touchend', resetJoystick);

        zone.addEventListener('mousedown', (e) => {
            joyActive = true;
            handleJoystickMove(e.clientX, e.clientY);
        });
        window.addEventListener('mousemove', (e) => {
            if (!joyActive) return;
            handleJoystickMove(e.clientX, e.clientY);
        });
        window.addEventListener('mouseup', resetJoystick);

        // --- KONTROL KEYBOARD (CADANGAN PC) ---
        const keys = {};
        window.addEventListener('keydown', (e) => keys[e.key.toLowerCase()] = true);
        window.addEventListener('keyup', (e) => keys[e.key.toLowerCase()] = false);

        // --- UPDATE POSISI & RENDER NEON ---
        function update() {
            const me = players[myId];
            if (!me) return;

            let moveX = joyVector.x;
            let moveY = joyVector.y;

            if (keys['w'] || keys['arrowup']) moveY = -1;
            if (keys['s'] || keys['arrowdown']) moveY = 1;
            if (keys['a'] || keys['arrowleft']) moveX = -1;
            if (keys['d'] || keys['arrowright']) moveX = 1;

            if (moveX !== 0 || moveY !== 0) {
                me.x += moveX * speed;
                me.y += moveY * speed;

                me.x = Math.max(22, Math.min(canvas.width - 22, me.x));
                me.y = Math.max(22, Math.min(canvas.height - 22, me.y));

                if (socket && socket.connected) {
                    socket.emit('move', { x: me.x, y: me.y });
                }
            }

            // Simpan jejak neon (trail) untuk semua pemain
            for (let id in players) {
                const p = players[id];
                if (!p.trail) p.trail = [];
                p.trail.push({ x: p.x, y: p.y });
                if (p.trail.length > 14) p.trail.shift();
            }
        }

        function drawNeonGrid() {
            ctx.save();
            ctx.strokeStyle = 'rgba(0, 243, 255, 0.08)';
            ctx.lineWidth = 1;
            const gridSize = 55;
            for (let x = 0; x < canvas.width; x += gridSize) {
                ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
            }
            for (let y = 0; y < canvas.height; y += gridSize) {
                ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
            }
            ctx.restore();
        }

        function loop() {
            update();
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            drawNeonGrid();

            for (let id in players) {
                const p = players[id];

                // 1. Gambar Jejak Cahaya (Neon Trail)
                if (p.trail && p.trail.length > 1) {
                    for (let i = 0; i < p.trail.length; i++) {
                        const point = p.trail[i];
                        const alpha = (i / p.trail.length) * 0.35;
                        const radius = (i / p.trail.length) * 16;
                        ctx.beginPath();
                        ctx.arc(point.x, point.y, radius, 0, Math.PI * 2);
                        ctx.fillStyle = p.color;
                        ctx.globalAlpha = alpha;
                        ctx.fill();
                    }
                    ctx.globalAlpha = 1;
                }

                // 2. Gambar Inti Karakter Neon dengan Efek Glow
                ctx.save();
                ctx.shadowBlur = 22;
                ctx.shadowColor = p.color;

                ctx.beginPath();
                ctx.arc(p.x, p.y, 18, 0, Math.PI * 2);
                ctx.fillStyle = '#090912';
                ctx.fill();

                ctx.lineWidth = 3.5;
                ctx.strokeStyle = p.color;
                ctx.stroke();

                // Titik cahaya putih di tengah
                ctx.beginPath();
                ctx.arc(p.x, p.y, 6, 0, Math.PI * 2);
                ctx.fillStyle = '#ffffff';
                ctx.fill();
                ctx.restore();

                // 3. Nama Pemain Neon
                ctx.save();
                ctx.shadowBlur = 8;
                ctx.shadowColor = p.color;
                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 12px sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(id === myId ? `${p.name} (Kamu)` : p.name, p.x, p.y - 28);
                ctx.restore();
            }

            requestAnimationFrame(loop);
        }

        loop();
    </script>
</body>
</html>
